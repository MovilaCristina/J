public override string ToString()
{
    string lMaterii = string.Join(", ", materii);
    return $"{base.ToString()} | {Facultate} | {Matricol} | {Medie} | [{lMaterii}]";
}

//OPERATOR +
public static Student operator +(Student s, string materie)
{
    if(s.materii==null)
    {
        s.materii = new List<string>();
    }
    s.materii.Add(materie);
    return s;
}

//OPERATOR INDEX
public string this[int index]
{
    get
    {
        if (index >= 0 && index < materii.Count)
            return materii[index];
        else
            return "Index invalid";
    }
}

//in tree
private void btAfisare_Click(object sender, EventArgs e)
{
    tvStudenti.Nodes.Clear();

    TreeNode parinte = new TreeNode("Studenti");
    tvStudenti.Nodes.Add(parinte);

    foreach(Student s in studenti)
    { 
        TreeNode copil = new TreeNode(s.Matricol);
        copil.Nodes.Add(s.Nume + "-" + s.Facultate + "-" + s.Medie);

        TreeNode m=new TreeNode("Materii");

        foreach(string materie in s.Materii)
        {
            m.Nodes.Add(materie);
        }
        copil.Nodes.Add(m);
        parinte.Nodes.Add(copil);
    }
    tvStudenti.ExpandAll();
}

//COMPARABLE<>
internal class Carte:Librarie,IComparable<Carte>
{
	public int CompareTo(Carte other)
	{
		if (other == null) return 1;

		if (this.pret < other.pret) return 1;
		if (this.pret > other.pret) return -1;
		return 0;
	}
}

