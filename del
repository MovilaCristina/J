//Afis listView
private void btAfiseazaList_Click(object sender, EventArgs e)
{
    lvBooks.Items.Clear();
    foreach(Carte c in carti)
    {
        ListViewItem lvi = new ListViewItem(c.Denumire);
        lvi.SubItems.Add(c.Cod);
        lvi.SubItems.Add(c.Titlu);
        lvi.SubItems.Add(c.Autor);
        lvi.SubItems.Add(c.Pret.ToString());
        lvBooks.Items.Add(lvi);
    }
}

